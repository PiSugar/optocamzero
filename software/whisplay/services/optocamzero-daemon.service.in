[Unit]
Description=Start Optocam Zero through whisplay-daemon
Requires=whisplay-daemon.service
After=whisplay-daemon.service pisugar-server.service
Wants=pisugar-server.service

[Service]
Type=oneshot
User=@USER@
Group=@GROUP@
Environment=HOME=@USER_HOME@
ExecStart=/usr/bin/python3 @APP_HOME@/autostart.py --home @APP_HOME@
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
