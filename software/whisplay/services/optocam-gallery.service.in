[Unit]
Description=Optocam Zero web gallery
After=network.target local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=2

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@APP_HOME@
Environment=HOME=@USER_HOME@
Environment=OPTOCAM_HOME=@APP_HOME@
Environment=OPTOCAM_PHOTOS_DIR=@APP_HOME@/photos
Environment=OPTOCAM_GALLERY_PORT=80
Environment=OPTOCAM_GALLERY_PRELOAD=0
Environment=OPTOCAM_GALLERY_THREADED=0
Environment=OPTOCAM_GALLERY_MAX_AS_MB=96
ExecStart=/usr/bin/python3 @APP_HOME@/gallery_server.py
Restart=on-failure
RestartSec=2
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Nice=5
CPUQuota=100%
MemoryHigh=64M
MemoryMax=96M
MemorySwapMax=16M
TasksMax=8
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
