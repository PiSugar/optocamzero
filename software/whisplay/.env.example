# Required for Magic modes. Keep this file private on the camera.
OPENAI_API_KEY=
OPTOCAM_MAGIC_PROXY=

# Optional generation tuning.
OPTOCAM_MAGIC_MODEL=chatgpt-image-latest
OPTOCAM_MAGIC_QUALITY=high
OPTOCAM_MAGIC_INPUT_FIDELITY=high
OPTOCAM_MAGIC_OUTPUT_COMPRESSION=95
OPTOCAM_MAGIC_SIZE=1024x1024
OPTOCAM_MAGIC_TIMEOUT=120
